{
  "name": "steadycut-coach",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @steadycut/api prisma:generate",
    "db:migrate": "pnpm --filter @steadycut/api prisma:migrate",
    "db:seed": "pnpm --filter @steadycut/api prisma:seed",
    "db:studio": "pnpm --filter @steadycut/api prisma:studio"
  },
  "dependencies": {
    "google-recaptcha": "^1.1.0",
    "pnpm": "^10.33.4",
    "react-google-recaptcha-v3": "^1.11.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/twilio": "^3.19.2"
  }
}
